<Application x:Class="HCC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101216" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#171A20" />
            <SolidColorBrush x:Key="CardBrush" Color="#1C2028" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2A303A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#939BA8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
