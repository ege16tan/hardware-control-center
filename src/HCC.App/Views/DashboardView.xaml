<UserControl x:Class="HCC.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="Aktualisieren"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="Systemleistung" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="CPU- und GPU-Werte kommen von verfügbaren Sensoren; RAM wird von Windows gemeldet." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">
            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                    <TextBlock Text="{Binding CpuUsageText}" FontSize="34" FontWeight="SemiBold" Margin="0,14,0,18" />
                    <ProgressBar Value="{Binding CpuUsage, Mode=OneWay}" Visibility="{Binding CpuAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Maximum="100" Height="6" Foreground="{DynamicResource ChartCpuBrush}" Background="{DynamicResource TrackBrush}" />
                    <TextBlock Text="Auslastung" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="GPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                    <TextBlock Text="{Binding GpuUsageText}" FontSize="34" FontWeight="SemiBold" Margin="0,14,0,18" />
                    <ProgressBar Value="{Binding GpuUsage, Mode=OneWay}" Visibility="{Binding GpuAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Maximum="100" Height="6" Foreground="{DynamicResource ChartGpuBrush}" Background="{DynamicResource TrackBrush}" />
                    <TextBlock Text="{Binding GpuUsageSource, StringFormat={}Sensor: {0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="ARBEITSSPEICHER" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
                    <TextBlock Text="{Binding MemoryUsageText}" FontSize="34" FontWeight="SemiBold" Margin="0,14,0,18" />
                    <ProgressBar Value="{Binding MemoryUsage, Mode=OneWay}" Visibility="{Binding MemoryAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Maximum="100" Height="6" Foreground="{DynamicResource ChartMemoryBrush}" Background="{DynamicResource TrackBrush}" />
                    <TextBlock Text="{Binding MemorySummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="2" Margin="0,22,0,0" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Leistungsverlauf" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SamplingDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    Background="{DynamicResource ChartBackgroundBrush}"
                                    LegendPosition="Bottom"
                                    LegendTextPaint="{Binding ChartLegendTextPaint}"
                                    LegendBackgroundPaint="{Binding ChartLegendBackgroundPaint}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
