<UserControl x:Class="HCC.App.Views.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FanSelectorItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="8"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        ToolTip="{Binding ControlLockedText}">
                    <TextBlock Text="🔒 Steuerung gesperrt"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="12" />
                </Border>
            </Grid>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FanChannels}"
                     SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource FanSelectorItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel MinWidth="84">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,1">
                                <TextBlock Text="{Binding Rpm, StringFormat={}{0:0}}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="RPM"
                                           FontSize="10"
                                           Margin="4,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ControlShortDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}">
                        <Run Text="Kurve · " /><Run Text="{Binding SelectedChannel.DisplayName, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="Temperaturquelle"
                               ToolTip="Die Sensor-ID bleibt über Neustarts stabil."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TemperatureSensors}"
                              SelectedItem="{Binding SelectedTemperatureSensor}"
                              Style="{StaticResource AppComboBoxStyle}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource InputForegroundBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperatur (°C)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Lüfter (%)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CurvePoints}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Padding="8,6"
                                             Margin="0,0,5,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Padding="8,6"
                                             Margin="0,0,5,0" />
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            ToolTip="Punkt entfernen"
                                            Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0"
                                            Margin="0,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Punkt hinzufügen"
                            Command="{Binding AddPointCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,2,0,10" />

                    <TextBlock Text="Kurvenvorschau (simulierte Temperatur, keine Steuerung)"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="{Binding PreviewTemperature}"
                            TickFrequency="10" />
                    <TextBlock Text="{Binding Preview}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Kanalstatus" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedChannel.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedChannel.HardwareDisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,1,0,6" />
                            <TextBlock Text="{Binding SelectedChannel.StatusDisplay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedChannel.ControlShortDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedChannel.CapabilityExplanation}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Kurvenprofile" Style="{StaticResource SectionHeaderStyle}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="Speichern"
                                Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="Laden"
                                Command="{Binding LoadProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right"
                                Content="Löschen"
                                Command="{Binding DeleteProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  Style="{StaticResource AppComboBoxStyle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CurveMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
