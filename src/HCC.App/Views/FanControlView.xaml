<UserControl x:Class="HCC.App.Views.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Lüftersteuerung" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ControlLockedText}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Erkannte Lüfterkanäle" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl ItemsSource="{Binding FanChannels}" Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding HardwareDisplayName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Rpm, StringFormat={}{0:0} RPM}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding ControlValueDisplay}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding CapabilityExplanation}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Kurveneditor · 2 bis 8 Punkte" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />

                    <TextBlock Text="Lüfterkanal" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FanChannels}"
                              SelectedItem="{Binding SelectedChannel}"
                              Style="{StaticResource AppComboBoxStyle}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectionDisplay}" Foreground="{DynamicResource InputForegroundBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Temperaturquelle (stabile Sensor-ID)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TemperatureSensors}"
                              SelectedItem="{Binding SelectedTemperatureSensor}"
                              Style="{StaticResource AppComboBoxStyle}"
                              Margin="0,0,0,14">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource InputForegroundBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperatur (°C)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Lüfter (%)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CurvePoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Margin="0,0,6,0" />
                                    <Button Grid.Column="2"
                                            Content="Entfernen"
                                            Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Punkt hinzufügen"
                            Command="{Binding AddPointCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,4,0,14" />

                    <TextBlock Text="Kurvenvorschau mit simulierter Temperatur (keine Steuerung)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="{Binding PreviewTemperature}"
                            TickFrequency="10"
                            Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <TextBlock Text="Kurvenprofile" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Speichern"
                                Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Laden"
                                Command="{Binding LoadProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right"
                                Content="Löschen"
                                Command="{Binding DeleteProfileCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  Style="{StaticResource AppComboBoxStyle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CurveMessage}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
