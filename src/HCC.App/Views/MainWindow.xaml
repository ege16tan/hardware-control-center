<Window x:Class="HCC.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HCC.App.ViewModels"
        xmlns:views="clr-namespace:HCC.App.Views"
        xmlns:controls="clr-namespace:HCC.App.Controls"
        Title="Hardware Control Center"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FanControlViewModel}">
            <views:FanControlView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16">
                <Border DockPanel.Dock="Top"
                        Width="36" Height="36" CornerRadius="10"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,26"
                        ToolTip="Hardware Control Center">
                    <TextBlock Text="H" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource RailButtonStyle}"
                        Content="&#xE713;"
                        ToolTip="Einstellungen"
                        AutomationProperties.Name="Einstellungen"
                        Command="{Binding NavigateSettingsCommand}"
                        controls:NavigationState.IsActive="{Binding IsSettingsActive}" />

                <StackPanel>
                    <Button Style="{StaticResource RailButtonStyle}"
                            Content="&#xE80F;"
                            ToolTip="Dashboard"
                            AutomationProperties.Name="Dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            controls:NavigationState.IsActive="{Binding IsDashboardActive}" />
                    <Button Style="{StaticResource RailButtonStyle}"
                            Content="&#xE9D9;"
                            ToolTip="Monitoring"
                            AutomationProperties.Name="Monitoring"
                            Command="{Binding NavigateMonitoringCommand}"
                            controls:NavigationState.IsActive="{Binding IsMonitoringActive}" />
                    <!-- The snowflake lives in Segoe UI Symbol, not in Segoe MDL2 Assets. -->
                    <Button Style="{StaticResource RailButtonStyle}"
                            Content="&#x2744;"
                            FontFamily="Segoe UI Symbol"
                            ToolTip="Lüftersteuerung"
                            AutomationProperties.Name="Lüftersteuerung"
                            Command="{Binding NavigateFanControlCommand}"
                            controls:NavigationState.IsActive="{Binding IsFanControlActive}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40,30,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource ChipStyle}" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding Dashboard.StatusIndicatorBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Dashboard.DataMode}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Dashboard.SystemTitle}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitleStyle}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1"
                    Background="{DynamicResource DangerSurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding Alerts.HasAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Alerts.AlertText}" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
